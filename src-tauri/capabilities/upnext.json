{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "upnext",
  "description": "The small up-next panel: it can read today's briefing, calendars and the system accent colour, hide itself, open the main window and open https links. Nothing that changes data.",
  "windows": [
    "upnext"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:window:allow-set-theme",
    "core:event:allow-unlisten",
    "allow-get-briefing",
    "allow-get-calendars",
    "allow-get-settings",
    "allow-get-system-accent",
    "allow-dismiss-up-next",
    "allow-open-briefing",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        }
      ]
    }
  ]
}