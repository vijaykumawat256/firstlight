{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "capture",
  "description": "The quick capture box: it can add a task or an event of your own, read settings (for the theme), and hide itself. Nothing else.",
  "windows": [
    "capture"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-theme",
    "allow-get-settings",
    "allow-get-system-accent",
    "allow-add-task",
    "allow-create-event",
    "allow-hide-capture"
  ]
}
