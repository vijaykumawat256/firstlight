{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: our own commands, event listening, window dragging, and https links.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        }
      ]
    },
    "allow-get-events",
    "allow-find-free-times",
    "allow-get-calendars",
    "allow-list-accounts",
    "allow-add-ics-account",
    "allow-add-caldav-account",
    "allow-add-oauth-account",
    "allow-system-calendar-status",
    "allow-add-system-account",
    "allow-open-privacy-settings",
    "allow-cancel-oauth",
    "allow-oauth-available",
    "allow-add-demo-account",
    "allow-remove-account",
    "allow-rename-account",
    "allow-set-calendar-visible",
    "allow-set-calendar-colour",
    "allow-refresh-now",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-get-unlock-count-today",
    "allow-get-briefing",
    "allow-dismiss-up-next",
    "allow-open-briefing",
    "allow-get-settings",
    "allow-set-settings",
    "allow-export-settings",
    "allow-save-settings-export",
    "allow-import-settings",
    "allow-erase-all-data",
    "allow-get-mail-digest",
    "allow-enable-apple-mail",
    "allow-enable-account-mail",
    "allow-ai-keys",
    "allow-sign-in-openrouter",
    "allow-writable-calendars",
    "allow-get-own-event",
    "allow-export-own-events",
    "allow-skip-event-occurrence",
    "allow-get-system-accent",
    "allow-prepare-invite",
    "allow-invite-senders",
    "allow-invite-preview",
    "allow-send-invite-mail",
    "allow-create-event",
    "allow-update-event",
    "allow-delete-event",
    "allow-add-imap-mailbox",
    "allow-remove-imap-mailbox",
    "allow-open-mail-message",
    "allow-ai-status",
    "allow-ai-preview",
    "allow-enable-ai",
    "allow-disable-ai",
    "allow-forget-ai-key",
    "allow-get-ai-summary",
    "allow-ask-calendar",
    "allow-get-meeting-prep",
    "allow-get-app-info",
    "allow-check-for-update",
    "allow-install-update",
    "allow-get-last-crash-report",
    "allow-clear-crash-reports"
  ]
}