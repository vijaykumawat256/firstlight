{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability for the app windows: only our own commands and event listening.",
  "windows": [
    "main",
    "upnext"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        }
      ]
    },
    "allow-get-events",
    "allow-get-calendars",
    "allow-list-accounts",
    "allow-add-ics-account",
    "allow-add-caldav-account",
    "allow-add-oauth-account",
    "allow-system-calendar-status",
    "allow-add-system-account",
    "allow-open-privacy-settings",
    "allow-cancel-oauth",
    "allow-oauth-available",
    "allow-add-demo-account",
    "allow-remove-account",
    "allow-rename-account",
    "allow-set-calendar-visible",
    "allow-set-calendar-colour",
    "allow-refresh-now",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-get-unlock-count-today",
    "allow-get-briefing",
    "allow-dismiss-up-next",
    "allow-open-briefing"
  ]
}