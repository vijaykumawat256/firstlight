{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability for the main window: only our own commands and event listening.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        }
      ]
    },
    "allow-get-events",
    "allow-get-calendars",
    "allow-list-accounts",
    "allow-add-ics-account",
    "allow-add-caldav-account",
    "allow-add-demo-account",
    "allow-remove-account",
    "allow-rename-account",
    "allow-set-calendar-visible",
    "allow-set-calendar-colour",
    "allow-refresh-now",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-get-unlock-count-today"
  ]
}