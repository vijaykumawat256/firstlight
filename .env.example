# Copy to .env (gitignored). See docs/OAUTH_SETUP.md for how to get these.
# They are read when the app is built, so restart `npm run tauri dev` after changing them.
# Client IDs are not secrets for desktop apps (PKCE protects sign-in), but are kept out of git anyway.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
